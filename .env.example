# Chave da API da OpenAI. Peca ao Sr. Mayer e cole abaixo. NAO compartilhe.
OPENAI_API_KEY=sk-cole-sua-chave-aqui

# Modelo de transcricao. gpt-4o-mini-transcribe e mais preciso que o whisper-1.
# Se a chave/projeto nao tiver acesso a ele (erro 403), troque por:  whisper-1
WHISPER_MODEL=gpt-4o-mini-transcribe

# Tecla de atalho (segura, fala, solta). Padrao: f9.
# Use teclas de funcao (f1..f12) ou um combo de modificadores (ex: ctrl_l+win).
# Modificador sozinho (ctrl/alt) atrapalha atalhos do sistema - evite.
# Tokens: f1..f12, ctrl_l, ctrl_r, win, alt, shift, ou uma letra. Combo com "+".
HOTKEY=f9

# Segundos que o microfone fica ABERTO depois do ultimo ditado. Abrir o
# dispositivo a frio custa ate 5s; mantendo-o quente, o ditado seguinte comeca
# na hora. Em troca, o indicador de "microfone em uso" do Windows fica aceso
# nesse intervalo. Padrao 180. Use 0 pra fechar na hora, ou 86400 pra sempre on.
MIC_WARM_SECONDS=180
